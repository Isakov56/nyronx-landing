# EmailJS — the second delivery channel for the consultation form.
# These are PUBLIC by design: Vite inlines VITE_* into the browser bundle, so
# they are visible to anyone either way. The real control is the allowed-origin
# list in the EmailJS dashboard (Account -> Security), which must include
# nyronx.com or these can be reused from any site.
VITE_EMAILJS_SERVICE_ID=service_0hkgcna
VITE_EMAILJS_TEMPLATE_ID=template_bpfz9vo
VITE_EMAILJS_PUBLIC_KEY=oiCB09ACPVLvUg-F9
